DATABASE_URL=
PORT=
CORS_ORIGIN=
# --- Auth / JWT ---
NODE_ENV=

# Access token: short-lived JWT (kept out of DB; delivered as HttpOnly Secure SameSite cookie).
JWT_ACCESS_TOKEN_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_IN=

# Refresh token: long-lived JWT, persisted in DB encrypted at rest (AES-256-GCM).
JWT_REFRESH_TOKEN_SECRET=
JWT_REFRESH_TOKEN_EXPIRES_IN=

# 32-byte (base64) symmetric key used to encrypt refresh tokens before storing them in the DB.
REFRESH_TOKEN_ENCRYPTION_KEY=
JWT_REFRESH_TOKEN_REMEMBER_EXPIRES_IN=
JWT_REFRESH_TOKEN_SESSION_EXPIRES_IN=

EMAIL_VERIFICATION_TOKEN_TTL=
PASSWORD_RESET_TOKEN_TTL=

# Cookie config
COOKIE_SECURE=
COOKIE_SAME_SITE=

# --- Resume upload ---
# HMAC key for signing short-lived resume upload URLs.
UPLOAD_URL_SIGNING_SECRET=
UPLOAD_URL_TTL=
# Local-disk storage root (swap FileStorageService for S3/R2 in production).
RESUME_STORAGE_DIR=
MAX_RESUME_SIZE_MB=
# Public origin used to build signed upload URLs returned to the client.
APP_BASE_URL=
FRONTEND_BASE_URL=

MAIL_TRANSPORT=
MAIL_FROM=
MAIL_FROM_NAME=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=